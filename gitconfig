[alias]
  co = checkout
  dti = -c diff.external=difft diff
  dc = diff --cached
  dtc = -c diff.external=difft diff --cached
  dtl = -c diff.external=difft log -p --ext-diff
  dts = -c diff.external=difft show --ext-diff
  lg = log --graph --pretty=format:' %C(red)%h%C(reset) - %s\n %C(blue)<%an> %C(green)%ar%C(yellow)%d%C(reset)\n'
  lgd = log --graph --pretty=format:' %C(red)%h%C(reset) - %s\n %C(blue)<%an> %C(green)%ai%C(yellow)%d%C(reset)\n'
  st = status
  pr = remote prune
  stu = stash --include-untracked
[color]
  ui = auto
[user]
  name = Scott Nielsen
  email = scottnielsen5@gmail.com
[core]
  excludesfile = ~/.gitignore
  pager = less -x2
[github]
  user = scizo
[push]
  default = upstream
[filter "trailingwhitespace"]
  clean = sed 's/[ \t]*$//'
  smudge = cat
[credential]
  helper = osxkeychain
#[url "git@github.com:"]
#  insteadOf = https://github.com/
#[commit]
# gpgsign = true
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge --skip -- %f
  process = git-lfs filter-process --skip
  required = true
[init]
  defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
